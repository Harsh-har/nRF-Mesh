<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/device_filter_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".DevicesFilterFragment">

    <!-- Title -->
    <TextView
        android:id="@+id/tvFilterTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=" Unprovision Device Filters"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Device Name Search -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilDeviceName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter Device name"
        app:layout_constraintTop_toBottomOf="@id/tvFilterTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeviceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- RSSI Signal Strength Filter -->
    <TextView
        android:id="@+id/tvRssi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Signal Strength"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tilDeviceName"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Signal Strength Indicators (3/4/5 bars) -->
    <RadioGroup
        android:id="@+id/rgSignalStrength"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvRssi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbSignalDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default"
            android:checked="true"
            android:layout_marginEnd="8dp"/>

        <RadioButton
            android:id="@+id/rbSignal3Bars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20-60%"
            android:layout_marginEnd="8dp"/>

        <RadioButton
            android:id="@+id/rbSignal4Bars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="60-90%"
            android:layout_marginEnd="8dp"/>

        <RadioButton
            android:id="@+id/rbSignal5Bars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="90-100%"/>
    </RadioGroup>

    <!-- Signal Strength Visual Indicator -->
    <LinearLayout
        android:id="@+id/layoutSignalPreview"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/rgSignalStrength"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvSignalPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Signal strength will be shown here"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"/>
    </LinearLayout>

    <!-- RSSI Value Display -->
    <TextView
        android:id="@+id/tvRssiValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RSSI: -50 dBm"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/layoutSignalPreview"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
       />

        <Button
            android:id="@+id/btnApply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>